{
  "schemaVersion": 1,
  "id": "stardew",
  "version": "${version}",

  "name": "Stardew Farming",
  "description": "A farming mod for BTA inspired by Stardew Valley",
  "authors": [
    "LukeisStuff",
    "Dundi Gundi",
    "BigSir"
  ],

  "icon": "icon.png",
  "contact": {
    "homepage": "",
    "sources": ""
  },
  "license": "CC0-1.0",
  "environment": "*",

  "entrypoints": {
    "main": [
      "luke.stardew.StardewMod"
    ],
    "beforeGameStart": [
      "luke.stardew.StardewMod",
      "luke.stardew.compat.aether.StardewAetherMod"
    ],
    "beforeClientStart": [
      "luke.stardew.StardewClient"
    ],
    "afterClientStart": [
      "luke.stardew.StardewClient"
    ],
    "recipesReady": [
      "luke.stardew.StardewRecipes",
      "luke.stardew.compat.aether.StardewAetherMod"
    ],
    "afterGameStart": [
      "luke.stardew.StardewMod"
    ],
    "initModels": [
      "luke.stardew.model.StardewModels",
      "luke.stardew.compat.aether.StardewAetherClient"
    ],
    "afterItemInit": [
      "luke.stardew.StardewMod"
    ],
    "preLaunch": [
      "luke.stardew.compat.aether.StardewAetherMod"
    ]
  },

  "mixins": [
    "stardew.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabricloader}",
    "halplibe": ">=${halplibe}",
    "minecraft": "*",
    "java": ">=${java}"
  },
  "suggests": {
    "modmenu": ">=${modmenu}"
  }
}

{
  "schemaVersion": 1,
  "id": "stardew",
  "version": "${version}",

  "name": "Stardew Farming",
  "description": "A farming mod for BTA inspired by Stardew Valley",
  "authors": [
    "LukeisStuff",
    "Dundi Gundi",
    "big sir"
  ],

  "icon": "icon.png",
  "contact": {
    "homepage": "",
    "sources": ""
  },
  "license": "CC0-1.0",
  "environment": "*",

  "entrypoints": {
    "main":   ["luke.stardew.StardewMod"    ],
    "client": ["luke.stardew.StardewClient" ]
  },

  "mixins": [
